# Copy to stack.env (or paste into the Portainer stack's environment
# variables). Nothing is strictly required: without AI settings the app reads
# recipes and typed lists with its own parser, and without SENTRY_DSN errors
# only go to the container log.

# ------------------------------------------------------------------- Login ---
# The household's password. Set it before the app is reachable from the
# internet; empty leaves it open, as on the LAN. At least 8 characters.
# A login lasts for good (until this password changes, or LOGIN_GENERATION in
# server/src/auth.ts is bumped and deployed — that signs every device out).
# The key that signs logins is made on first start and kept in the data
# volume as session.key, so logins survive restarts and redeploys.
GROCER_PASSWORD=
# Wrong passwords allowed per visitor before a pause of this many minutes.
# LOGIN_MAX_FAILURES=10
# LOGIN_FAILURE_WINDOW_MINUTES=15

# --------------------------------------------------------------- AI harness ---
# The homelab's LiteLLM harness, OpenAI-compatible. Include the /v1. Use a
# name the Pi-hole knows (ops.bech.lol) or the IP. The bare host name "ai-ops"
# may not resolve from inside containers.
AI_BASE_URL=http://ops.bech.lol:4000/v1
# A virtual key issued by the harness for this app. Required with AI_BASE_URL.
AI_API_KEY=
# A harness model alias, not a provider model — the harness decides what
# actually answers. app-fast is plenty for parsing ingredients.
AI_MODEL=app-fast
# Reading a long recipe page can take a while on a busy model.
AI_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ Nemlig ---
# Send to Nemlig goes through the harness's MCP gateway with AI_API_KEY, so it
# is on whenever the AI is. The key needs access to the nemlig MCP server in
# LiteLLM. Set false to hide it.
NEMLIG_ENABLED=true
# Defaults to the gateway beside AI_BASE_URL (http://ai-ops:4000/mcp/).
# NEMLIG_MCP_URL=
# The server's alias in the harness's mcp_servers.
NEMLIG_MCP_SERVER=nemlig
NEMLIG_TIMEOUT_SECONDS=60

# --------------------------------------------------------- Error reporting ---
# Sentry-protocol error reporting; GlitchTip ingests the same envelope format.
# Leave empty to disable it entirely — nothing is sent and no connection is
# attempted. GlitchTip shows the DSN under Settings → Projects → <project> →
# Client Keys. A malformed DSN stops the container at startup rather than
# silently dropping errors later. Once set, open /api/throw to send a test event.
#
# A DSN on a host behind a Caddy `tls internal` CA (glitch.bech.lol) needs that
# CA's root mounted into the container (see deploy/docker-compose.yml) and:
# NODE_EXTRA_CA_CERTS=/certs/glitch-root.crt
#
# Errors from the browser are forwarded by the server with this same DSN, so
# phones never need to reach GlitchTip (or trust its certificate) themselves.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Stamped into published images by CI (grocer@<sha>); set it here only to override.
# SENTRY_RELEASE=
# Defaults to the container hostname.
SENTRY_SERVER_NAME=grocer
# The AI harness being down could otherwise produce an event per request.
SENTRY_MAX_EVENTS_PER_MINUTE=30

# ----------------------------------------------------------------- General ---
TZ=Europe/Copenhagen
# info | debug | warn | error
LOG_LEVEL=info
# The host port in deploy/docker-compose.yml (the container always uses 8080).
GROCER_PORT=8083
